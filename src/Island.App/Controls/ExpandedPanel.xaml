<UserControl x:Class="Island.App.Controls.ExpandedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Island.App.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Island.App;component/Controls/PanelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 默认值 = 深色主题；宿主在 IslandWindow.UpdatePanelResources 里按当前主题整体覆盖。 -->
            <SolidColorBrush x:Key="Fg" Color="#F2F3F5"/>
            <SolidColorBrush x:Key="FgDim" Color="#A9AEB9"/>
            <SolidColorBrush x:Key="FgTertiary" Color="#7C828F"/>
            <SolidColorBrush x:Key="Accent" Color="#2DD4BF"/>
            <SolidColorBrush x:Key="OnAccent" Color="#08090D"/>
            <SolidColorBrush x:Key="Track" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="Hairline" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="CardFill" Color="#09FFFFFF"/>
            <SolidColorBrush x:Key="Hover" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="Pressed" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="FillStrong" Color="#2EFFFFFF"/>
            <SolidColorBrush x:Key="Knob" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="KnobOn" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ScrollThumb" Color="#30FFFFFF"/>
            <!-- 圆角随主题：像素主题把这几项改成 2 / 2 / 0 / 3 -->
            <CornerRadius x:Key="RadiusBtn">7</CornerRadius>
            <CornerRadius x:Key="RadiusPill">11</CornerRadius>
            <CornerRadius x:Key="RadiusTrack">2</CornerRadius>
            <CornerRadius x:Key="RadiusCard">14</CornerRadius>

            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <local:InverseBoolToVis x:Key="InvVis"/>
            <local:MuteTextConverter x:Key="MuteText"/>

            <!-- 列表页的一行：图标 + 内容 + 右侧补充 -->
            <Style x:Key="ListRow" TargetType="Grid">
                <Setter Property="Height" Value="30"/>
            </Style>
            <!-- 控制页的一行：定宽标签列 + 状态/控件 + 右侧动作 -->
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="MinHeight" Value="30"/>
            </Style>
            <!-- 紧凑按钮（一排放五个的那种） -->
            <Style x:Key="QuietBtnSm" TargetType="Button" BasedOn="{StaticResource QuietBtn}">
                <Setter Property="Padding" Value="7,0"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
            </Style>
            <!-- 等宽的数据字体（顶栏时钟、列表里的时间 / 大小） -->
            <Style x:Key="DataText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 面板整体：底色由岛体本体（IslandCanvas）画，这里只排内容
         内容区内边距 = 左右 18 / 上 14 / 下 18（ExpandedPanelSpec.ContentPadX / ContentPadTop / ContentPadBottom），
         code-behind 里再按常量覆写一次（XAML 读不到 const，规格类才是唯一事实来源）。 -->
    <Grid x:Name="rootGrid" Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏（对齐 mac 的 IslandCanvas.DrawExpanded / Tab(...)）：左 页签（图标 + 文字）｜ 右 时间 + 设置齿轮 + 收起
             顶栏高度 = 图标 14（TabIconSize）+ 上下各 5（TabPadY）= 24；顶栏到内容区 40（ContentTopOffset = 24 + 16）。
             页签整体仍左对齐（mac 就是左对齐）；时钟靠右、排在齿轮左边 ——
             Windows 专属的「设置齿轮 / 收起 ✕」保留（mac 靠移开鼠标收起）。 -->
        <Grid x:Name="topBar" Grid.Row="0" Height="24" Margin="0,0,0,16">
            <!-- 页签：图标 14（TabIconSize）+ 间距 5（TabIconGap）+ 文字 12（TabFontSize）；
                 热区左右 7 / 上下 5（TabPadX / TabPadY），相邻间距 6（TabGap），左端离面板左边缘 20（TabLeftOffset）；
                 激活底 = Accent 20%（TabActiveFillAlpha）+ 圆角 8（TabActiveCorner），由代码写入。
                 XAML 读不到 const，上面这些数值在 code-behind 里按 ExpandedPanelSpec 再覆写一次。 -->
            <StackPanel x:Name="tabBar" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="2,0,0,0">
                <Grid Margin="0,0,6,0">
                    <Border x:Name="tabFillMonitor" Background="Transparent" CornerRadius="8"/>
                    <Button x:Name="btnMonitor" Tag="0" Click="OnPage" ToolTip="系统监控" Style="{StaticResource TabBtn}"
                            Width="Auto" Height="Auto" Padding="7,5" Margin="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:GlyphIcon x:Name="tabIconMonitor" Kind="Monitor" Width="14" Height="14"
                                             VerticalAlignment="Center" TextElement.Foreground="{DynamicResource FgDim}"/>
                            <TextBlock x:Name="tabTextMonitor" Text="监控" FontSize="12" VerticalAlignment="Center"
                                       Margin="5,0,0,0" Foreground="{DynamicResource FgDim}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Margin="0,0,6,0">
                    <Border x:Name="tabFillShelf" Background="Transparent" CornerRadius="8"/>
                    <Button x:Name="btnShelf" Tag="1" Click="OnPage" ToolTip="剪贴板 · 文件" Style="{StaticResource TabBtn}"
                            Width="Auto" Height="Auto" Padding="7,5" Margin="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:GlyphIcon x:Name="tabIconShelf" Kind="Clipboard" Width="14" Height="14"
                                             VerticalAlignment="Center" TextElement.Foreground="{DynamicResource FgDim}"/>
                            <TextBlock x:Name="tabTextShelf" Text="剪贴板" FontSize="12" VerticalAlignment="Center"
                                       Margin="5,0,0,0" Foreground="{DynamicResource FgDim}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Margin="0,0,6,0">
                    <Border x:Name="tabFillDevices" Background="Transparent" CornerRadius="8"/>
                    <Button x:Name="btnDevices" Tag="2" Click="OnPage" ToolTip="设备电量" Style="{StaticResource TabBtn}"
                            Width="Auto" Height="Auto" Padding="7,5" Margin="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:GlyphIcon x:Name="tabIconDevices" Kind="Battery" Width="14" Height="14"
                                             VerticalAlignment="Center" TextElement.Foreground="{DynamicResource FgDim}"/>
                            <TextBlock x:Name="tabTextDevices" Text="设备" FontSize="12" VerticalAlignment="Center"
                                       Margin="5,0,0,0" Foreground="{DynamicResource FgDim}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid>
                    <Border x:Name="tabFillControl" Background="Transparent" CornerRadius="8"/>
                    <Button x:Name="btnControl" Tag="3" Click="OnPage" ToolTip="控制" Style="{StaticResource TabBtn}"
                            Width="Auto" Height="Auto" Padding="7,5" Margin="0" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:GlyphIcon x:Name="tabIconControl" Kind="Sliders" Width="14" Height="14"
                                             VerticalAlignment="Center" TextElement.Foreground="{DynamicResource FgDim}"/>
                            <TextBlock x:Name="tabTextControl" Text="控制" FontSize="12" VerticalAlignment="Center"
                                       Margin="5,0,0,0" Foreground="{DynamicResource FgDim}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
            <!-- 右侧一组：时钟 → 齿轮 → 收起。时钟 12 号 Regular 比例字体（去掉 DataText 的等宽体），
                 颜色 FgDim，右侧留白 24（ClockRightMargin）。 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="clockText" VerticalAlignment="Center" FontSize="12" FontWeight="Normal"
                           Foreground="{DynamicResource FgDim}" Margin="0,0,24,0"/>
                <!-- 设置齿轮（BrimDeck 顶栏同款：右端齿轮直达设置中心，不用退到托盘） -->
                <Button x:Name="btnSettings" Click="OnSettings" ToolTip="设置中心" Style="{StaticResource TabBtn}" Margin="0,0,2,0">
                    <local:GlyphIcon Kind="Gear" Width="15" Height="15"/>
                </Button>
                <Button x:Name="btnClose" Click="OnClose" ToolTip="收起" Style="{StaticResource TabBtn}">
                    <local:GlyphIcon Kind="Close" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 页面容器：一次只显示一页 -->
        <Grid Grid.Row="1">

            <!-- 页0：系统监控（自绘） -->
            <local:MonitorPage x:Name="monitorPage"/>

            <!-- 页1：剪贴板 · 文件（列表行；空状态是一句话，不占列表的位置） -->
            <Grid x:Name="pageShelf" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="216"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GroupCard}" Padding="14,2,14,6" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="剪贴板" Style="{StaticResource GroupLabel}"/>
                        <TextBlock Grid.Row="1" Text="复制的内容会出现在这里" Style="{StaticResource EmptyHint}" Margin="0,10,0,0"
                                   Visibility="{Binding HasClipboard, Converter={StaticResource InvVis}}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding Clipboard}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource QuietBtn}" Height="32" Margin="0,2" Padding="6,0" Click="OnRestoreClipboard" ToolTip="点击恢复到系统剪贴板；然后在目标窗口粘贴">
                                        <Grid Style="{StaticResource ListRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <local:GlyphIcon Width="13" Height="13" VerticalAlignment="Center" Kind="Clipboard"
                                                             TextElement.Foreground="{DynamicResource FgDim}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="10.5" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Style="{StaticResource DataText}" Foreground="{DynamicResource FgTertiary}"/>
                                        </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GroupCard}" Padding="14,2,14,6" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="文件" Style="{StaticResource GroupLabel}"/>
                        <TextBlock Grid.Row="1" Text="把文件拖到岛体上可暂存" Style="{StaticResource EmptyHint}" Margin="0,10,0,0"
                                   Visibility="{Binding HasFiles, Converter={StaticResource InvVis}}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Style="{StaticResource ListRow}" ToolTip="{Binding Full}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <local:GlyphIcon Width="13" Height="13" VerticalAlignment="Center" Kind="File"
                                                             TextElement.Foreground="{DynamicResource FgDim}" Opacity="0.8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Style="{StaticResource DataText}" Foreground="{DynamicResource FgTertiary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 页2：设备电量（整页自绘，铺满页面高度，不套滚动条） -->
            <Grid x:Name="pageDevices" Visibility="Collapsed">
                <local:DevicesPage x:Name="devicesPage"/>
            </Grid>

            <!-- 页3：控制。左右两栏、每组一块卡片，全部控制项一屏读完（不用滚动） -->
            <Grid x:Name="pageControl" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左栏：显示 / 声音 -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="显示" Style="{StaticResource GroupLabel}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="亮度" Style="{StaticResource RowLabel}"/>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="&#x2212;" Style="{StaticResource StepBtn}" Command="{Binding BrightnessDown}" Margin="0,0,8,0"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource ThinProgress}" Maximum="1"
                                                 Value="{Binding BrightnessValue, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Brightness}" Style="{StaticResource RowValue}" Width="46" TextAlignment="Right"/>
                                    <Button Grid.Column="3" Content="+" Style="{StaticResource StepBtn}" Command="{Binding BrightnessUp}" Margin="6,0,0,0"/>
                                </Grid>
                            </Grid>
                            <!-- 夜灯（不支持时不显示） -->
                            <Grid Style="{StaticResource Row}" Visibility="{Binding HasNightLight, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="夜灯" Style="{StaticResource RowLabel}"/>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NightLightOn}"
                                          Checked="OnNightLightToggle" Unchecked="OnNightLightToggle"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="浅色模式" Style="{StaticResource RowLabel}"/>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsLightTheme}"
                                          Checked="OnLightThemeToggle" Unchecked="OnLightThemeToggle"/>
                            </Grid>
                            <!-- 鼠标穿透（只显示不拦截，游戏适用） -->
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="鼠标穿透" Style="{StaticResource RowLabel}"/>
                                <TextBlock Grid.Column="1" Text="游戏时不拦截点击" Style="{StaticResource RowState}"/>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClickThrough}"
                                          Checked="OnClickThroughToggle" Unchecked="OnClickThroughToggle"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GroupCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="声音" Style="{StaticResource GroupLabel}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="音量" Style="{StaticResource RowLabel}"/>
                                <Slider Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" TickFrequency="0.05"
                                        Value="{Binding VolumeValue, Mode=OneWay}" ValueChanged="OnVolumeSlider"
                                        ToolTip="滚轮悬停岛体也可调节"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnMic" Style="{StaticResource QuietBtn}" Content="麦克风"
                                            ToolTip="切换麦克风静音" Click="OnMicToggle" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource QuietBtn}" Content="{Binding IsMuted, Converter={StaticResource MuteText}}"
                                            Click="OnMuteToggle"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右栏：连接 / 电源 / 系统 -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="连接" Style="{StaticResource GroupLabel}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="WLAN" Style="{StaticResource RowLabel}"/>
                                <!-- 连接状态与适配器开关是两回事（"开着没连热点" vs "已关闭"），分两行显示 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WlanState}" Style="{StaticResource RowState}"/>
                                    <TextBlock Text="{Binding WlanAdapterState}" Style="{StaticResource RowState}" FontSize="10"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="切换" Style="{StaticResource QuietBtn}" Command="{Binding ToggleWlan}"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="蓝牙" Style="{StaticResource RowLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding BtState}" Style="{StaticResource RowState}"/>
                                <Button Grid.Column="2" Content="切换" Style="{StaticResource QuietBtn}" Command="{Binding ToggleBt}"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Text="电源" Style="{StaticResource GroupLabel}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="电源计划" Style="{StaticResource RowLabel}"/>
                                <!-- 电源计划按钮由代码铺（powercfg 枚举，当前项是实心强调色 + 辉光） -->
                                <WrapPanel Grid.Column="1" x:Name="powerPlanHost" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="电源" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="锁屏" Style="{StaticResource QuietBtn}" Command="{Binding LockCommand}" Margin="0,0,6,0"/>
                                    <Button Content="睡眠" Style="{StaticResource QuietBtn}" Command="{Binding SleepCommand}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GroupCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="系统" Style="{StaticResource GroupLabel}"/>
                            <!-- 内存清理：按钮点击即清，结果显示在行内 -->
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="内存清理" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="memCleanResult" Grid.Column="1" Text="释放闲置内存" Style="{StaticResource RowState}" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="清理" Style="{StaticResource QuietBtn}" Click="OnCleanMemory"/>
                            </Grid>
                            <!-- Windows 设置的快捷入口 -->
                            <WrapPanel Margin="0,6,0,4">
                                <Button Content="网络" Style="{StaticResource QuietBtnSm}" Command="{Binding OpenSettingsCommand}" CommandParameter="network"/>
                                <Button Content="声音" Style="{StaticResource QuietBtnSm}" Command="{Binding OpenSettingsCommand}" CommandParameter="sound"/>
                                <Button Content="显示" Style="{StaticResource QuietBtnSm}" Command="{Binding OpenSettingsCommand}" CommandParameter="display"/>
                                <Button Content="电源" Style="{StaticResource QuietBtnSm}" Command="{Binding OpenSettingsCommand}" CommandParameter="power"/>
                                <Button Content="蓝牙" Style="{StaticResource QuietBtnSm}" Command="{Binding OpenBtSettings}" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
