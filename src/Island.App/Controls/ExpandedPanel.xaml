<UserControl x:Class="Island.App.Controls.ExpandedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.App.Controls">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#F21C1C1E"/>
        <SolidColorBrush x:Key="CardBg" Color="#252527"/>
        <SolidColorBrush x:Key="Fg" Color="#F2F2F7"/>
        <SolidColorBrush x:Key="FgDim" Color="#A3A3AA"/>
        <SolidColorBrush x:Key="FgTertiary" Color="#8E9AB4"/>
        <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
        <SolidColorBrush x:Key="Track" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="Down" Color="#30D158"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <controls:InverseBoolToVis x:Key="InvVis"/>
        <controls:MuteTextConverter x:Key="MuteText"/>

        <!-- BrimDeck 式扁平按钮 -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FFFFFFF" TargetName="bd"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF" TargetName="bd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent" CornerRadius="22" Padding="2">
        <Grid Margin="14,9,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶栏（对齐 macOS DrawExpanded）：左 矢量图标+中文页签胶囊 ｜ 中右 实时时间 + 设置齿轮 + 收起 -->
            <Grid Grid.Row="0" Margin="2,0,2,10">
                <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource CardBg}" CornerRadius="10" Padding="3,2">
                    <StackPanel Orientation="Horizontal">
                        <!-- 0: 监控 -->
                        <Button x:Name="btnMonitor" Tag="0" Click="OnPage" ToolTip="系统监控"
                                Height="25" Padding="8,0" Style="{StaticResource FlatBtn}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="icoMonitor" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{DynamicResource FgDim}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 1,8 L 4,8 L 6,3 L 8.5,13 L 10.5,6 L 12,8 L 15,8"/>
                                <TextBlock x:Name="lblMonitor" Text="监控" FontSize="11.5" Margin="4,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                            </StackPanel>
                        </Button>
                        <!-- 1: 媒体 -->
                        <Button x:Name="btnMedia" Tag="1" Click="OnPage" ToolTip="媒体播放"
                                Height="25" Padding="8,0" Style="{StaticResource FlatBtn}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="icoMedia" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource FgDim}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 5,12 L 5,3.5 L 13,2 L 13,10.5 M 5,12 A 2,2 0 1 1 1,12 A 2,2 0 1 1 5,12 M 13,10.5 A 2,2 0 1 1 9,10.5 A 2,2 0 1 1 13,10.5"/>
                                <TextBlock x:Name="lblMedia" Text="媒体" FontSize="11.5" Margin="4,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                            </StackPanel>
                        </Button>
                        <!-- 2: 剪贴板 · 文件 -->
                        <Button x:Name="btnShelf" Tag="2" Click="OnPage" ToolTip="剪贴板 · 文件中转"
                                Height="25" Padding="8,0" Style="{StaticResource FlatBtn}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="icoShelf" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource FgDim}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 5,2.5 L 11,2.5 L 11,4.5 L 5,4.5 Z M 5,3.5 L 3,3.5 L 3,14.5 L 13,14.5 L 13,3.5 L 11,3.5 M 5.5,8 L 10.5,8 M 5.5,11 L 9.5,11"/>
                                <TextBlock x:Name="lblShelf" Text="剪贴板" FontSize="11.5" Margin="4,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                            </StackPanel>
                        </Button>
                        <!-- 3: 设备 -->
                        <Button x:Name="btnDevices" Tag="3" Click="OnPage" ToolTip="设备电量"
                                Height="25" Padding="8,0" Style="{StaticResource FlatBtn}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="icoDevices" Width="13" Height="11" Stretch="Uniform"
                                      Stroke="{DynamicResource FgDim}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 1.5,3.5 L 12.5,3.5 L 12.5,10.5 L 1.5,10.5 Z M 14,5.5 L 14,8.5 M 4,6 L 9,6 L 9,8 L 4,8 Z"/>
                                <TextBlock x:Name="lblDevices" Text="设备" FontSize="11.5" Margin="4,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                            </StackPanel>
                        </Button>
                        <!-- 4: 控制 -->
                        <Button x:Name="btnControl" Tag="4" Click="OnPage" ToolTip="显示器 · 控制"
                                Height="25" Padding="8,0" Style="{StaticResource FlatBtn}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="icoControl" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource FgDim}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 2,4.5 L 14,4.5 M 9,2.5 L 9,6.5 M 2,10.5 L 14,10.5 M 5,8.5 L 5,12.5"/>
                                <TextBlock x:Name="lblControl" Text="控制" FontSize="11.5" Margin="4,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 右上角：时间 + 设置齿轮 + 收起按钮（与 macOS 展开顶栏一致） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="clockText" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}"/>
                    <Button x:Name="btnSettings" Click="OnSettings" ToolTip="打开设置中心"
                            Width="28" Height="24" Margin="0,0,2,0" Style="{StaticResource FlatBtn}">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource FgDim}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 8,5.2 A 2.8,2.8 0 1 1 7.99,5.2 M 8,1.5 L 8,3 M 8,13 L 8,14.5 M 1.5,8 L 3,8 M 13,8 L 14.5,8 M 3.4,3.4 L 4.5,4.5 M 11.5,11.5 L 12.6,12.6 M 12.6,3.4 L 11.5,4.5 M 4.5,11.5 L 3.4,12.6"/>
                    </Button>
                    <Button x:Name="btnClose" Click="OnClose" ToolTip="收起"
                            Width="28" Height="24" Style="{StaticResource FlatBtn}">
                        <Path Width="10" Height="10" Stretch="Uniform"
                              Stroke="{DynamicResource FgDim}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 2,2 L 10,10 M 10,2 L 2,10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 页面容器：一次只显示一页 -->
            <Grid Grid.Row="1">

                <!-- 页0：系统监控 -->
                <controls:MonitorPage x:Name="monitorPage"/>

                <!-- 页1：媒体播放 -->
                <controls:MediaPage x:Name="mediaPage" Visibility="Collapsed"/>

                <!-- 页2：剪贴板工作台 · 文件中转 -->
                <Grid x:Name="pageShelf" Visibility="Collapsed" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="186"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左栏：剪贴板分类筛选栏 + 富卡片列表 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部分类胶囊 + 导出 / 清空 -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="导出" Height="22" Padding="8,0" FontSize="10.5"
                                        Foreground="{DynamicResource FgDim}" Style="{StaticResource FlatBtn}"
                                        ToolTip="导出全部剪贴板条目到下载文件夹" Click="OnClipboardExport"/>
                                <Button Content="清空" Height="22" Padding="8,0" Margin="2,0,0,0" FontSize="10.5"
                                        Foreground="{DynamicResource FgDim}" Style="{StaticResource FlatBtn}"
                                        ToolTip="清空非常驻记录" Click="OnClipboardClear"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="fltAll" Tag="all" Content="全部" Height="22" Padding="8,0" Margin="0,0,3,0"
                                        FontSize="10.5" Foreground="{DynamicResource Fg}" Style="{StaticResource FlatBtn}" Click="OnClipFilter"/>
                                <Button x:Name="fltCommon" Tag="common" Content="常用" Height="22" Padding="8,0" Margin="0,0,3,0"
                                        FontSize="10.5" Foreground="{DynamicResource FgDim}" Style="{StaticResource FlatBtn}" Click="OnClipFilter"/>
                                <Button x:Name="fltLink" Tag="link" Content="链接" Height="22" Padding="8,0" Margin="0,0,3,0"
                                        FontSize="10.5" Foreground="{DynamicResource FgDim}" Style="{StaticResource FlatBtn}" Click="OnClipFilter"/>
                                <Button x:Name="fltCode" Tag="code" Content="代码" Height="22" Padding="8,0"
                                        FontSize="10.5" Foreground="{DynamicResource FgDim}" Style="{StaticResource FlatBtn}" Click="OnClipFilter"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Clipboard}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBg}" CornerRadius="9" Cursor="Hand"
                                                Padding="9,6" Margin="0,0,0,5" ToolTip="{Binding ToolTipText}"
                                                MouseLeftButtonUp="OnClipboardItemClick"
                                                MouseRightButtonUp="OnClipboardItemRightClick">
                                            <DockPanel>
                                                <!-- 右侧：相对时间 + 常驻星标 + 删除 × -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding LinesBadge}" Visibility="{Binding HasLinesBadge}"
                                                               FontSize="9" Foreground="{DynamicResource FgTertiary}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding RelTime}" FontSize="9"
                                                               Foreground="{DynamicResource FgTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Button Content="{Binding PinGlyph}" Opacity="{Binding PinOpacity}"
                                                            Width="20" Height="20" FontSize="11" ToolTip="标记/取消常驻（不被自动淘汰）"
                                                            Foreground="{DynamicResource Accent}" Style="{StaticResource FlatBtn}"
                                                            Click="OnClipboardPinClick"/>
                                                    <Button Content="✕" Width="20" Height="20" FontSize="9.5" ToolTip="删除此条记录"
                                                            Foreground="{DynamicResource FgDim}" Style="{StaticResource FlatBtn}"
                                                            Click="OnClipboardDeleteClick"/>
                                                </StackPanel>

                                                <!-- 左侧：分类圆点 + 可选颜色块/图片缩略图 + 文本预览 -->
                                                <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding DotBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <Border DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="3"
                                                        Background="{Binding ColorSwatch}" Visibility="{Binding HasSwatch}"
                                                        BorderBrush="#44FFFFFF" BorderThickness="0.8"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border DockPanel.Dock="Left" Width="34" Height="22" CornerRadius="4"
                                                        Visibility="{Binding HasThumb}" ClipToBounds="True"
                                                        VerticalAlignment="Center" Margin="0,0,7,0">
                                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding Preview}" FontFamily="{Binding Font}" FontSize="11"
                                                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2" x:Name="shelfHint"
                                   Text="点击条目写回剪贴板（支持文本与图片）· 星标常驻 · 右键也可置顶"
                                   Foreground="{DynamicResource FgDim}" FontSize="9.5"
                                   HorizontalAlignment="Left" Margin="2,4,0,0"/>
                    </Grid>

                    <!-- 右栏：文件中转 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="文件中转（拖入岛体暂存）" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Fg}" Margin="2,2,0,2"/>
                            <TextBlock Text="点击定位 · 按住拖出 · 右键移除" FontSize="9.5"
                                       Foreground="{DynamicResource FgDim}" Margin="2,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBg}" CornerRadius="9" Cursor="Hand"
                                                Padding="9,6" Margin="0,0,0,5" ToolTip="{Binding Full}"
                                                MouseLeftButtonDown="OnFileItemMouseDown"
                                                MouseMove="OnFileItemMouseMove"
                                                MouseLeftButtonUp="OnFileItemClick"
                                                MouseRightButtonUp="OnFileItemRightClick">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="11"
                                                           Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Size}" FontSize="9"
                                                           Foreground="{DynamicResource FgDim}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 页3：设备电量 -->
                <ScrollViewer x:Name="pageDevices" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <controls:DevicesPage x:Name="devicesPage" Height="330"/>
                </ScrollViewer>

                <!-- 页4：多显示器无级 DDC/CI 控制 + 系统控制 -->
                <ScrollViewer x:Name="pageControl" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel>
                        <!-- 多显示器控制区（对齐 LunarCN / Mac 版 screens 页：每台屏幕独立亮度/对比度/音量滑杆） -->
                        <StackPanel x:Name="displayCardsHost"/>

                        <!-- 系统主音量（滑杆 + 静音 + 麦克风） -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="系统音量" FontSize="12"
                                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Width="68"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="btnMic" Width="60" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11" Content="麦克风"
                                            ToolTip="切换麦克风静音" Click="OnMicToggle" Margin="0,0,6,0"/>
                                    <Button Width="66" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Content="{Binding IsMuted, Converter={StaticResource MuteText}}"
                                            Click="OnMuteToggle"/>
                                </StackPanel>
                                <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                                        Value="{Binding VolumeValue, Mode=OneWay}"
                                        ValueChanged="OnVolumeSlider"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </DockPanel>
                        </Border>

                        <!-- 电源计划 -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="电源计划" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="平衡 / 高性能 / 节能（即时切换）" FontSize="10"
                                               Foreground="{DynamicResource FgDim}"/>
                                </StackPanel>
                                <WrapPanel DockPanel.Dock="Right" x:Name="powerPlanHost"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- WLAN -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="WLAN" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="{Binding WlanState}" FontSize="10" Foreground="{DynamicResource FgDim}"/>
                                    <TextBlock Text="{Binding WlanAdapterState}" FontSize="10" Foreground="{DynamicResource FgDim}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="切换" Width="52" Height="26"
                                        Style="{StaticResource FlatBtn}" Foreground="{DynamicResource Fg}" FontSize="11"
                                        Command="{Binding ToggleWlan}" HorizontalAlignment="Right"/>
                                <TextBlock Text="（切换需管理员确认）" FontSize="9" Foreground="{DynamicResource FgDim}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </DockPanel>
                        </Border>

                        <!-- 蓝牙 -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="蓝牙" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="{Binding BtState}" FontSize="10" Foreground="{DynamicResource FgDim}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="切换" Width="52" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding ToggleBt}" Margin="0,0,6,0"/>
                                    <Button Content="设置" Width="52" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding OpenBtSettings}"/>
                                </StackPanel>
                                <TextBlock Text="bthserv 服务开关" FontSize="9" Foreground="{DynamicResource FgDim}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </DockPanel>
                        </Border>

                        <!-- 系统浅色模式 -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="系统浅色模式" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="切换 Windows 应用深/浅色（即时生效）" FontSize="10"
                                               Foreground="{DynamicResource FgDim}"/>
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsLightTheme}"
                                          Checked="OnLightThemeToggle" Unchecked="OnLightThemeToggle"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>

                        <!-- 夜灯 -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8"
                                Visibility="{Binding HasNightLight, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="夜灯（夜间模式）" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="暖色温护眼，数秒内生效" FontSize="10"
                                               Foreground="{DynamicResource FgDim}"/>
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NightLightOn}"
                                          Checked="OnNightLightToggle" Unchecked="OnNightLightToggle"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>

                        <!-- 鼠标穿透 -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="鼠标穿透" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="岛体只显示不拦截点击；悬停不展开，适合游戏" FontSize="10"
                                               Foreground="{DynamicResource FgDim}"/>
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ClickThrough}"
                                          Checked="OnClickThroughToggle" Unchecked="OnClickThroughToggle"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>

                        <!-- 内存清理 -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="内存清理" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock x:Name="memCleanResult" Text="清空各进程工作集，释放可用内存" FontSize="10"
                                               Foreground="{DynamicResource FgDim}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="立即清理" Width="66" Height="26"
                                        Style="{StaticResource FlatBtn}" Foreground="{DynamicResource Fg}" FontSize="11"
                                        Click="OnCleanMemory" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>

                        <!-- 锁屏 / 睡眠 -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="电源" FontSize="12"
                                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Width="60"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="锁屏" Width="56" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding LockCommand}" Margin="0,0,6,0"/>
                                    <Button Content="睡眠" Width="56" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding SleepCommand}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 系统设置快捷链接 -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="系统设置" FontSize="12"
                                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Width="60"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="网络" Width="50" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding OpenSettingsCommand}" CommandParameter="network" Margin="0,0,4,0"/>
                                    <Button Content="声音" Width="50" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding OpenSettingsCommand}" CommandParameter="sound" Margin="0,0,4,0"/>
                                    <Button Content="显示" Width="50" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding OpenSettingsCommand}" CommandParameter="display" Margin="0,0,4,0"/>
                                    <Button Content="电源" Width="50" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding OpenSettingsCommand}" CommandParameter="power"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="滚轮切收起视图 · Ctrl+Alt+Space 展开/收起 · Ctrl+Alt+D 切样式 · Ctrl+Alt+S 切页签" FontSize="9.5"
                                   Foreground="{DynamicResource FgDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
