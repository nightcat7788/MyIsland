<!-- 窗口背景必须是 null（不能是 Transparent）：
     Transparent 会让 WPF 模板的 Border 铺满整片 640×500 并参与命中，
     岛体没画到的位置会把点击和滚轮吃掉（底层应用收不到）。
     离屏探针验证：Background={x:Null} 时窗口空白处不再命中，自绘控件画到的位置仍然命中。 -->
<Window x:Class="Island.App.Controls.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Island.App.Controls"
        Title="Island" Width="600" Height="440"
        WindowStyle="None" AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize">
    <Grid x:Name="Root">
        <!-- 自绘液态岛 + 收起态内容 -->
        <controls:IslandCanvas x:Name="islandCanvas"
                               MouseLeftButtonDown="OnMouseLeftDown"
                               MouseLeftButtonUp="OnMouseLeftUp"
                               MouseMove="OnMouseMove"
                               MouseRightButtonDown="OnMouseRightDown"
                               MouseWheel="OnMouseWheel"/>

        <!-- 展开面板 -->
        <controls:ExpandedPanel x:Name="expandedPanel" Opacity="0" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="540" Height="380" Margin="0,0,0,0"/>
    </Grid>
</Window>
