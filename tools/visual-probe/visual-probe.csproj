<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>visual-probe</AssemblyName>
    <RootNamespace>Island.Tools.VisualProbe</RootNamespace>
    <!-- 离屏渲染视觉回归探针（开发期专用，不属于 Island.sln：与 tools/hid-probe 同例）。
         刻意**不引用 Island.App 工程**（WPF exe 引用 + 资源加载容易出岔子），
         改成像 hid-probe 那样直接链接源文件 —— 探针渲染的就是产品要用的那份源码。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 被测页面（纯自绘控件，渲染的就是产品源码） -->
    <Compile Include="..\..\src\Island.App\Controls\MonitorPage.cs" Link="Merged\Controls\MonitorPage.cs" />
    <Compile Include="..\..\src\Island.App\Controls\DevicesPage.cs" Link="Merged\Controls\DevicesPage.cs" />
    <!-- 渲染层 / 图标 / 规格常量 -->
    <Compile Include="..\..\src\Island.App\Controls\RenderKit.cs" Link="Merged\Controls\RenderKit.cs" />
    <Compile Include="..\..\src\Island.App\Controls\Glyphs.cs" Link="Merged\Controls\Glyphs.cs" />
    <Compile Include="..\..\src\Island.App\Controls\ExpandedPanelSpec.cs" Link="Merged\Controls\ExpandedPanelSpec.cs" />
    <Compile Include="..\..\src\Island.App\Controls\CompactSpec.cs" Link="Merged\Controls\CompactSpec.cs" />
    <!-- 收起态 dash（用户 99% 时间看到的那一面）：IslandCanvas 自绘收起态，
         连带它依赖的紧凑规格 / 液态几何 / 小形象 / 两个服务类 -->
    <Compile Include="..\..\src\Island.App\Controls\IslandCanvas.cs" Link="Merged\Controls\IslandCanvas.cs" />
    <Compile Include="..\..\src\Island.App\Controls\CompactLayout.cs" Link="Merged\Controls\CompactLayout.cs" />
    <Compile Include="..\..\src\Island.App\Animation\LiquidGeometry.cs" Link="Merged\Animation\LiquidGeometry.cs" />
    <Compile Include="..\..\src\Island.App\Animation\PetFace.cs" Link="Merged\Animation\PetFace.cs" />
    <Compile Include="..\..\src\Island.App\Services\ClipboardService.cs" Link="Merged\Services\ClipboardService.cs" />
    <Compile Include="..\..\src\Island.App\Services\FileTrayService.cs" Link="Merged\Services\FileTrayService.cs" />
    <Compile Include="..\..\src\Island.App\Services\WeatherService.cs" Link="Merged\Services\WeatherService.cs" />
    <Compile Include="..\..\src\Island.App\Services\Settings.cs" Link="Merged\Services\Settings.cs" />
    <!-- 主题色板 -->
    <Compile Include="..\..\src\Island.App\Themes\Theme.cs" Link="Merged\Themes\Theme.cs" />
    <!-- 动画（RenderKit 用到 Easing.Clamp） -->
    <Compile Include="..\..\src\Island.App\Animation\Spring.cs" Link="Merged\Animation\Spring.cs" />
    <!-- 两端共享的能力清单与底部状态行规格（纯数据，无 WPF 依赖） -->
    <Compile Include="..\..\src\Island.Core\Capabilities\*.cs" Link="Merged\Core\Capabilities\%(Filename)%(Extension)" />
    <!-- 监控快照模型（纯数据，无 WPF 依赖） -->
    <Compile Include="..\..\src\Island.Core\Monitoring\*.cs" Link="Merged\Core\Monitoring\%(Filename)%(Extension)" />
    <!-- 硬件传感器取值规则（含 GPU 显存口径的显示形状：纯逻辑） -->
    <Compile Include="..\..\src\Island.App\Services\HardwareSensorRules.cs" Link="Merged\Services\HardwareSensorRules.cs" />
    <!-- 温度快照 / 设备读数（纯数据） -->
    <Compile Include="..\..\src\Island.App\Services\ThermalSnapshot.cs" Link="Merged\Services\ThermalSnapshot.cs" />
    <Compile Include="..\..\src\Island.App\Controls\ThermalDisplay.cs" Link="Merged\Controls\ThermalDisplay.cs" />
    <Compile Include="..\..\src\Island.App\Services\DeviceInfo.cs" Link="Merged\Services\DeviceInfo.cs" />
  </ItemGroup>

</Project>
