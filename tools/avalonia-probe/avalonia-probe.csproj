<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>avalonia-probe</AssemblyName>
    <RootNamespace>Island.Tools.AvaloniaProbe</RootNamespace>
    <!-- macOS 端离屏渲染视觉回归探针（开发期专用，不属于 Island.sln：与 tools/visual-probe 同例）。
         Avalonia 依赖只落在这里 —— 零 NuGet 的测试工程不受影响。
         渲染的是产品源码（引用 Island.Avalonia 工程），不是抄一份副本。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 离屏渲染：Headless 平台 + 真实 Skia 绘制（UseHeadlessDrawing = false） -->
    <PackageReference Include="Avalonia.Headless" Version="11.2.2" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 被测对象：产品工程本身（IslandCanvas / Palette / DeviceBattery / 共享规格） -->
    <ProjectReference Include="..\..\src\Island.Avalonia\Island.Avalonia.csproj" />
  </ItemGroup>

</Project>
