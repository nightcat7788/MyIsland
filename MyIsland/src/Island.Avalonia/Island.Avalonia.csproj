<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1416（平台兼容性分析器）：本工程刻意保持单 TFM net8.0 跨平台，
         而 SystemMonitor / GpuUsageReader 引用的 PDH、WMI 等 Windows 专用 API
         位于「仅在 Windows 上实例化」的采样切片中（运行时由 OperatingSystem.IsWindows() 分流），
         分析器看不到这条运行时分支 ⇒ 在此统一抑制。
         抑制只作用于本工程；Windows 主工程 Island.App 仍保留该告警。 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Mac 版：dotnet publish -c Release -r osx-arm64（self-contained） -->
  </PropertyGroup>

  <!-- 与 Island.App.csproj 同样的守卫：重定向 BaseIntermediateOutputPath 时，
       SDK 的默认排除会失效，仓库里遗留的 obj\**\*.AssemblyInfo.cs 会被当成源码二次编译（CS0579 重复定义） -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj/**;bin/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- 与 Windows 版共享：数据模型 / 配额（纯 .NET 跨平台）/ 弹簧 / Windows 采样器 -->
  <ItemGroup>
    <Compile Include="..\Island.Core\Monitoring\MonitorModels.cs" Link="Merged\MonitorModels.cs" />
    <Compile Include="..\Island.Native\SystemMonitor.cs" Link="Merged\SystemMonitor.cs" />
    <!-- 采样层通配符 PDH 查询器（SystemMonitor/GpuUsageReader 依赖它，必须一起链进来，
         否则跨平台工程编译不过：CS0246 找不到 PdhWildcardQuery） -->
    <Compile Include="..\Island.Native\PdhWildcardQuery.cs" Link="Merged\PdhWildcardQuery.cs" />
    <Compile Include="..\Island.Native\NativeMethods.cs" Link="Merged\NativeMethods.cs" />
    <Compile Include="..\Island.Native\GpuUsageReader.cs" Link="Merged\GpuUsageReader.cs" />
    <Compile Include="..\Island.App\Animation\Spring.cs" Link="Merged\Spring.cs" />
    <!-- 温度服务是纯 .NET + LHM（无 WPF 依赖）：Windows 上提供 CPU/GPU/SSD 温度；Mac 上自动无数据 -->
    <Compile Include="..\Island.App\Services\ThermalService.cs" Link="Merged\ThermalService.cs" />
    <!-- 温度快照（2026-11-24 从 ThermalService.cs 拆出的独立文件，ThermalService 依赖它） -->
    <Compile Include="..\Island.App\Services\ThermalSnapshot.cs" Link="Merged\ThermalSnapshot.cs" />
    <Compile Include="..\Island.App\Services\InpOutSmnService.cs" Link="Merged\InpOutSmnService.cs" />
    <!-- SMN 高风险通道的所有者（ThermalService 依赖它，必须一起链进来） -->
    <Compile Include="..\Island.App\Services\SmnChannel.cs" Link="Merged\SmnChannel.cs" />
    <!-- 温度驱动（PawnIO）在不在的判定（ThermalService.DriverPresent 的来源，必须一起链进来）。
         只用到注册表读取与版本比较：非 Windows 上 InstalledVersion() 直接返回 null；本工程不调用安装 -->
    <Compile Include="..\Island.App\Services\PawnIoInstaller.cs" Link="Merged\PawnIoInstaller.cs" />
    <!-- Intel GCL 初始化拦截策略（ThermalService.OpenComputer 依赖它）。只用反射按名字取库里的类型；
         非 Windows 上探测会抛平台异常，被策略自己兜成"不拦" -->
    <Compile Include="..\Island.App\Services\IntelComputePolicy.cs" Link="Merged\IntelComputePolicy.cs" />
    <!-- 天气/设置是纯 .NET（Open-Meteo + JSON），跨平台直接复用 -->
    <Compile Include="..\Island.App\Services\WeatherService.cs" Link="Merged\WeatherService.cs" />
    <Compile Include="..\Island.App\Services\Settings.cs" Link="Merged\Settings.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\branding\island-logo-32.png" />
  </ItemGroup>
</Project>
