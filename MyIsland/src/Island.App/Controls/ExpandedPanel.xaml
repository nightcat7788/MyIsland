<UserControl x:Class="Island.App.Controls.ExpandedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.App.Controls">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#F20D1117"/>
        <SolidColorBrush x:Key="CardBg" Color="#282B36"/>
        <SolidColorBrush x:Key="Fg" Color="White"/>
        <SolidColorBrush x:Key="FgDim" Color="#A0A6B6"/>
        <SolidColorBrush x:Key="FgTertiary" Color="#6B7486"/>
        <SolidColorBrush x:Key="Accent" Color="#5A96FF"/>
        <SolidColorBrush x:Key="Track" Color="#303640"/>
        <SolidColorBrush x:Key="Down" Color="#3CBE78"/>
        <SolidColorBrush x:Key="WarmOrange" Color="#E8906F"/>
        <SolidColorBrush x:Key="WarmYellow" Color="#E8C88F"/>
        <SolidColorBrush x:Key="DataBlue" Color="#2E9BFF"/>
        <SolidColorBrush x:Key="DataCyan" Color="#4FE3D7"/>
        <SolidColorBrush x:Key="DataPink" Color="#F272A8"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <controls:InverseBoolToVis x:Key="InvVis"/>

        <!-- BrimDeck 式扁平按钮（页签/关闭/媒体控制共用）：透明底、圆角、悬停淡亮 -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FFFFFFF" TargetName="bd"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF" TargetName="bd"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 面板整体：BrimDeck 式近黑深底 + 大圆角 -->
    <Border Background="{DynamicResource PanelBg}" CornerRadius="20" Padding="2">
        <Grid Margin="14,10,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶栏（BrimDeck 式）：左 页面切换分段胶囊 ｜ 中 时间 ｜ 右 关闭 -->
            <Grid Grid.Row="0" Margin="2,0,2,10">
                <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource CardBg}" CornerRadius="11" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnMonitor" Tag="0" Click="OnPage" ToolTip="系统监控"
                                Width="32" Height="24" Style="{StaticResource FlatBtn}">
                            <TextBlock Text="📈" FontSize="12" Foreground="{DynamicResource FgDim}"/>
                        </Button>
                        <Button x:Name="btnQuota" Tag="1" Click="OnPage" ToolTip="AI 用量"
                                Width="32" Height="24" Style="{StaticResource FlatBtn}">
                            <TextBlock Text="💠" FontSize="12" Foreground="{DynamicResource FgDim}"/>
                        </Button>
                        <Button x:Name="btnShelf" Tag="2" Click="OnPage" ToolTip="剪贴板 · 文件"
                                Width="32" Height="24" Style="{StaticResource FlatBtn}">
                            <TextBlock Text="⎘" FontSize="12" Foreground="{DynamicResource FgDim}"/>
                        </Button>
                        <Button x:Name="btnDevices" Tag="3" Click="OnPage" ToolTip="设备电量"
                                Width="32" Height="24" Style="{StaticResource FlatBtn}">
                            <TextBlock Text="🔋" FontSize="11" Foreground="{DynamicResource FgDim}"/>
                        </Button>
                        <Button x:Name="btnControl" Tag="4" Click="OnPage" ToolTip="控制"
                                Width="32" Height="24" Style="{StaticResource FlatBtn}">
                            <TextBlock Text="🎛" FontSize="12" Foreground="{DynamicResource FgDim}"/>
                        </Button>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="clockText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}"/>
                <Button x:Name="btnClose" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnClose" ToolTip="收起" Width="28" Height="24" Style="{StaticResource FlatBtn}">
                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource FgDim}"/>
                </Button>
            </Grid>

            <!-- 页面容器：一次只显示一页 -->
            <Grid Grid.Row="1">

                <!-- 页0：系统监控（自绘 ftop 式） -->
                <controls:MonitorPage x:Name="monitorPage"/>

                <!-- 页1：AI 用量（BrimDeck 式分列：名称+徽章、大百分比、进度条、今日/七日汇总） -->
                <ScrollViewer x:Name="pageQuota" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Quotas}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="140" Margin="10,4">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Fg}"/>
                                        <Border DockPanel.Dock="Right" Padding="6,1.5" CornerRadius="6"
                                                BorderBrush="{DynamicResource FgTertiary}" BorderThickness="1">
                                            <TextBlock Text="{Binding StatusText}" FontSize="9"
                                                       Foreground="{DynamicResource FgDim}"/>
                                        </Border>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,5" LastChildFill="False">
                                        <TextBlock Text="{Binding PercentText}" FontSize="21" FontWeight="Bold"
                                                   Foreground="{Binding PercentBrush}"/>
                                        <TextBlock Text="已用" FontSize="10" Foreground="{DynamicResource FgDim}"
                                                   VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                    </DockPanel>
                                    <ProgressBar Maximum="1" Height="4" Value="{Binding UsedFraction}"
                                                 Foreground="{Binding PercentBrush}"
                                                 Background="{DynamicResource Track}"/>
                                    <Border Height="1" Background="{DynamicResource Track}" Margin="0,12,0,8" Opacity="0.6"/>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="今日" FontSize="10" Foreground="{DynamicResource FgDim}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TokensToday}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                                    </DockPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                        <TextBlock Text="费用" FontSize="10" Foreground="{DynamicResource FgDim}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CostToday}"
                                                   FontSize="11" Foreground="{DynamicResource FgDim}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="9.5"
                                               Foreground="{DynamicResource FgTertiary}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 页2：剪贴板 · 文件 -->
                <Grid x:Name="pageShelf" Visibility="Collapsed" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Clipboard}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBg}" CornerRadius="10"
                                                Padding="10,7" Margin="0,0,0,6" ToolTip="{Binding Full}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="9"
                                                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Preview}" FontSize="11"
                                                           Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="复制文字/图片后自动记录（仅本地内存）" Foreground="{DynamicResource FgDim}"
                                       FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="文件中转（拖入岛体暂存）" FontSize="10"
                                       Foreground="{DynamicResource FgDim}" Margin="2,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBg}" CornerRadius="10"
                                                Padding="10,7" Margin="0,0,0,6" ToolTip="{Binding Full}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="11"
                                                           Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Size}" FontSize="9"
                                                           Foreground="{DynamicResource FgDim}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 页3：设备电量 -->
                <ScrollViewer x:Name="pageDevices" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBg}" CornerRadius="12"
                                            Padding="14,10" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Width="180"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <ProgressBar DockPanel.Dock="Right" Width="130" Height="6" Maximum="1"
                                                         Value="{Binding Fraction}" Foreground="{Binding Color}"
                                                         Background="{DynamicResource Track}" HorizontalAlignment="Right"
                                                         VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Kind}" FontSize="10"
                                                           Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PercentText}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{Binding Color}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="未检测到无线设备（蓝牙/HID 电量）" Foreground="{DynamicResource FgDim}"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Visibility="{Binding HasDevices, Converter={StaticResource InvVis}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 页4：控制 -->
                <ScrollViewer x:Name="pageControl" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="亮度" FontSize="12"
                                           Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Width="60"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="－" Width="30" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" Command="{Binding BrightnessDown}"/>
                                    <TextBlock Text="{Binding Brightness}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg}" Width="52" TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Button Content="＋" Width="30" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" Command="{Binding BrightnessUp}"/>
                                </StackPanel>
                                <ProgressBar Height="6" Maximum="1" Value="{Binding BrightnessValue, Mode=OneWay}"
                                             Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="WLAN" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="{Binding WlanState}" FontSize="10" Foreground="{DynamicResource FgDim}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="切换" Width="52" Height="26"
                                        Style="{StaticResource FlatBtn}" Foreground="{DynamicResource Fg}" FontSize="11"
                                        Command="{Binding ToggleWlan}" HorizontalAlignment="Right"/>
                                <TextBlock Text="（切换需管理员确认）" FontSize="9" Foreground="{DynamicResource FgDim}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="蓝牙" FontSize="12" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock Text="{Binding BtState}" FontSize="10" Foreground="{DynamicResource FgDim}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="切换" Width="52" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding ToggleBt}" Margin="0,0,6,0"/>
                                    <Button Content="设置" Width="52" Height="26" Style="{StaticResource FlatBtn}"
                                            Foreground="{DynamicResource Fg}" FontSize="11"
                                            Command="{Binding OpenBtSettings}"/>
                                </StackPanel>
                                <TextBlock Text="bthserv 服务开关" FontSize="9" Foreground="{DynamicResource FgDim}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="音量：滚轮悬停岛体调节（收起态浮条）；静音走系统托盘" FontSize="10"
                                   Foreground="{DynamicResource FgDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
