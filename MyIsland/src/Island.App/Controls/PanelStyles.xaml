<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 展开面板的控件样式（2026-11-24 视觉重做）。
         以前控制页 / 设备页里是 WPF 默认模板的进度条、滑杆、复选框和系统滚动条 —— 白轨道、方框、带箭头的浅色滚动条压在深色玻璃上，
         和面板自己画的监控页完全不是一套东西。这里给面板用到的每个控件一个统一的模板：
         高度 26–28、圆角跟随主题（RadiusSm）、1px 发丝线边框、默认态安静（透明底），悬停 / 按下才提亮。
         颜色全部来自面板资源字典里的语义令牌（宿主在 UpdatePanelResources 里按主题写入）。 -->

    <!-- == 文字 == -->
    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource FgTertiary}"/>
        <Setter Property="Margin" Value="2,6,0,1"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="RowState" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="EmptyHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource FgTertiary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- == 按钮 == -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <!-- 默认态：半透明底（CardFill）+ 1px 发丝线，安静但不失形；悬停 / 按下由模板里的触发器提亮 -->
        <Setter Property="Background" Value="{DynamicResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 圆角比按钮小 1px、边框收在半像素上：细边框落在整像素上才不发虚 -->
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusBtn}" Padding="{TemplateBinding Padding}"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Hover}" TargetName="bd"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Pressed}" TargetName="bd"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 常规动作：1px 发丝线边框，读得出是个按钮，又不抢戏 -->
    <Style x:Key="QuietBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <!-- 图标按钮：无边框，悬停给一层底色 -->
    <Style x:Key="TabBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <!-- 页签默认透明（不给底色）；选中态的压色由代码作为本地值写入 -->
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- 步进按钮（亮度 − +） -->
    <Style x:Key="StepBtn" TargetType="Button" BasedOn="{StaticResource QuietBtn}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- 强调色按钮：实心强调色 + 深色字，外面一圈同色辉光（辉光由代码在选中时挂 Effect）。
         全面板只有"选中的电源计划"用它 —— 发光是稀缺资源，到处发光等于没有发光。
         自己带模板：悬停 / 按下改透明度而不是换底色，否则实心的强调色一悬停就变回灰色。 -->
    <Style x:Key="AccentBtn" TargetType="Button">
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{DynamicResource Accent}" CornerRadius="{DynamicResource RadiusBtn}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.86" TargetName="bd"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.72" TargetName="bd"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组卡片：半透明底 + 1px 微光边（暗色科技的卡片配方：深色主题是 3.5% 的白，浅色主题是 4% 的黑） -->
    <Style x:Key="GroupCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
        <Setter Property="Padding" Value="12,2,12,4"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- == 开关（CheckBox 换模板：轨道 + 圆钮；选中 = 强调色轨道） == -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="38" Height="22">
                        <Border x:Name="track" Background="{DynamicResource FillStrong}" CornerRadius="{DynamicResource RadiusPill}"/>
                        <Ellipse x:Name="thumb" Width="16" Height="16" Fill="{DynamicResource Knob}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 圆钮靠挪 Margin 走到另一头（模板触发器只能点到框架元素，点不到里面的 Transform） -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Accent}" TargetName="track"/>
                            <Setter Property="Fill" Value="{DynamicResource KnobOn}" TargetName="thumb"/>
                            <Setter Property="Margin" Value="19,0,0,0" TargetName="thumb"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- == 细滑杆：4px 轨道，左半段强调色填充，14px 圆钮 == -->
    <Style x:Key="SliderPart" TargetType="RepeatButton">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusTrack}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThinSlider" TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" Background="{DynamicResource Track}" CornerRadius="{DynamicResource RadiusTrack}"/>
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderPart}" Background="{DynamicResource Accent}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderPart}" Background="Transparent"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource Knob}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- == 细进度条：4px 轨道 + 强调色填充 == -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource Track}" CornerRadius="{DynamicResource RadiusTrack}"/>
                        <Border x:Name="PART_Indicator" Background="{DynamicResource Accent}" CornerRadius="{DynamicResource RadiusTrack}"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- == 细滚动条（面板内所有 ScrollViewer 生效）：6px、无箭头、半透明圆头滑块 == -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource ScrollThumb}" CornerRadius="{DynamicResource RadiusTrack}" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
